PORT=3000

# local or unleash
FLAG_PROVIDER=local

# Used only when FLAG_PROVIDER=unleash
UNLEASH_URL=http://localhost:4242/api/
UNLEASH_API_TOKEN=replace-with-backend-token
UNLEASH_APP_NAME=node09-feature-practice

# Maximum age of the latest confirmed
# Unleash configuration sync
FLAG_MAX_STALE_MS=60000
